<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ASA.ServerManager.Domain\ASA.ServerManager.Domain.csproj" />
    <ProjectReference Include="..\..\src\ASA.ServerManager.Application\ASA.ServerManager.Application.csproj" />
    <ProjectReference Include="..\..\src\ASA.ServerManager.Infrastructure\ASA.ServerManager.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ASA.ServerManager.WinForms\ASA.ServerManager.WinForms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\definitions\game-settings.json" Link="definitions\game-settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\definitions\maps.json" Link="definitions\maps.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
