{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRDB going signal selection v0.5 research candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version","release_status","source_contract","race","as_of_exclusive","historical_profile_asof","denominator","selection_policy","policy","summary","horses"],
  "properties": {
    "contract_version": {"const":"brdb-going-signal-selection-v0.5-candidate"},
    "release_status": {"const":"RESEARCH_ONLY"},
    "source_contract": {"const":"brdb-going-condition-comparison-v0.4-candidate"},
    "race": {"type":"object"},
    "as_of_exclusive": {"type":"string","format":"date"},
    "historical_profile_asof": {"const":"AS_OF_UNVERIFIED"},
    "denominator": {"const":"NORMAL_FINISHERS_ONLY"},
    "selection_policy": {"type":"object"},
    "policy": {"type":"object","additionalProperties":false,"required":["prediction_safe","production_authorized","display_authorized","suitability_claim"],"properties":{"prediction_safe":{"const":false},"production_authorized":{"const":false},"display_authorized":{"const":false},"suitability_claim":{"const":false}}},
    "summary": {"type":"object"},
    "horses": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["horse_id","horse_no","candidate_count","scope_direction_consistency","nested_scopes_independent","primary","candidates"],"properties":{"horse_id":{"type":"string","pattern":"^[0-9]{8}$"},"horse_no":{"type":"integer","minimum":1},"candidate_count":{"type":"integer","minimum":0},"scope_direction_consistency":{"enum":["NONE","CONSISTENT","MIXED"]},"nested_scopes_independent":{"const":false},"primary":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/candidate"}]},"candidates":{"type":"array","items":{"$ref":"#/$defs/candidate"}}}}}
  },
  "$defs": {
    "ci": {"type":"object","additionalProperties":false,"required":["low","high"],"properties":{"low":{"type":"number","minimum":0,"maximum":1},"high":{"type":"number","minimum":0,"maximum":1}}},
    "group": {"type":"object","additionalProperties":false,"required":["starts","top3","top3_rate","wilson95"],"properties":{"starts":{"type":"integer","minimum":1},"top3":{"type":"integer","minimum":0},"top3_rate":{"type":"number","minimum":0,"maximum":1},"wilson95":{"$ref":"#/$defs/ci"}}},
    "candidate": {"type":"object","additionalProperties":false,"required":["scope_key","direction","tier","selectable","difference_top3_pp","good","non_good","wilson_intervals_separated","interpretation_status","suitability_claim","prediction_eligible","display_eligible"],"properties":{"scope_key":{"enum":["VENUE_COURSE_DISTANCE","VENUE_DISTANCE","ALL_VENUES_DISTANCE","VENUE_BAND","ALL_VENUES_BAND"]},"direction":{"enum":["NON_GOOD_HIGHER","GOOD_HIGHER","EQUAL"]},"tier":{"enum":["STRONG_DESCRIPTIVE","NOTABLE_DESCRIPTIVE","LOW_SAMPLE_SIGNAL","ROUTINE_OBSERVATION"]},"selectable":{"type":"boolean"},"difference_top3_pp":{"type":"number","minimum":-100,"maximum":100},"good":{"$ref":"#/$defs/group"},"non_good":{"$ref":"#/$defs/group"},"wilson_intervals_separated":{"type":"boolean"},"interpretation_status":{"const":"OBSERVATION_ONLY"},"suitability_claim":{"const":false},"prediction_eligible":{"const":false},"display_eligible":{"const":false}}}
  }
}
