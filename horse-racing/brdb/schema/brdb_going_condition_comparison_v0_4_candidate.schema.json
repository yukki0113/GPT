{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRDB going-condition comparison v0.4 research-only candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version","release_status","race","as_of_exclusive","historical_profile_asof","denominator","scope_policy","source","policy","total_scope_comparisons","horses"],
  "properties": {
    "contract_version": {"const":"brdb-going-condition-comparison-v0.4-candidate"},
    "release_status": {"const":"RESEARCH_ONLY"},
    "race": {"type":"object"},
    "as_of_exclusive": {"type":"string","format":"date"},
    "historical_profile_asof": {"const":"AS_OF_UNVERIFIED"},
    "denominator": {"const":"NORMAL_FINISHERS_ONLY"},
    "scope_policy": {"const":"SURFACE_FIXED_GOOD_VS_SLIGHTLY_HEAVY_HEAVY_BAD"},
    "source": {"type":"object","additionalProperties":false,
      "required":["generation_id","manifest_sha256","verified_partitions","source_total_rows","eligible_rows","target_day_results_excluded"],
      "properties": {"generation_id":{"type":"string"},"manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"verified_partitions":{"type":"integer","minimum":1},"source_total_rows":{"type":"integer","minimum":1},"eligible_rows":{"type":"integer","minimum":0},"target_day_results_excluded":{"const":true}}},
    "policy": {"type":"object","additionalProperties":false,
      "required":["prediction_safe","production_authorized","display_authorized","suitability_claim"],
      "properties":{"prediction_safe":{"const":false},"production_authorized":{"const":false},"display_authorized":{"const":false},"suitability_claim":{"const":false}}},
    "total_scope_comparisons":{"type":"integer","minimum":0},
    "horses":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
      "required":["horse_id","horse_no","sire_name","scopes","findings"],
      "properties":{"horse_id":{"type":"string","pattern":"^[0-9]{8}$"},"horse_no":{"type":"integer","minimum":1},"sire_name":{"type":"string","minLength":1},
        "scopes":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"object","additionalProperties":false,
          "required":["scope_key","scope_status","observation"],
          "properties":{"scope_key":{"enum":["VENUE_COURSE_DISTANCE","VENUE_DISTANCE","ALL_VENUES_DISTANCE","VENUE_BAND","ALL_VENUES_BAND"]},"scope_status":{"enum":["CONTEXT_UNAVAILABLE","RESEARCH_OBSERVED"]},"observation":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/observation"}]}}}},
        "findings":{"type":"array","items":{"type":"object","additionalProperties":false,
          "required":["kind","scope_key","delta_top3_pp","sample_status","interpretation_status","prediction_eligible","display_eligible"],
          "properties":{"kind":{"const":"GOOD_VS_NON_GOOD"},"scope_key":{"type":"string"},"delta_top3_pp":{"type":"number"},"sample_status":{"enum":["LOW_SAMPLE","DESCRIPTIVE"]},"interpretation_status":{"const":"OBSERVATION_ONLY"},"prediction_eligible":{"const":false},"display_eligible":{"const":false}}}}}}}
  },
  "$defs": {
    "counts": {"type":"object","additionalProperties":false,"required":["starts","wins","top3","win_rate","top3_rate"],
      "properties":{"starts":{"type":"integer","minimum":0},"wins":{"type":"integer","minimum":0},"top3":{"type":"integer","minimum":0},"win_rate":{"type":["number","null"],"minimum":0,"maximum":1},"top3_rate":{"type":["number","null"],"minimum":0,"maximum":1}}},
    "observation": {"type":"object","additionalProperties":false,
      "required":["good","non_good","comparison_status","sample_status","difference_top3_pp","interpretation_status","prediction_eligible","display_eligible","suitability_claim"],
      "properties":{"good":{"$ref":"#/$defs/counts"},"non_good":{"$ref":"#/$defs/counts"},"comparison_status":{"enum":["OBSERVED","INSUFFICIENT_COMPARISON"]},"sample_status":{"enum":["LOW_SAMPLE","DESCRIPTIVE"]},"difference_top3_pp":{"type":["number","null"],"minimum":-100,"maximum":100},"interpretation_status":{"const":"OBSERVATION_ONLY"},"prediction_eligible":{"const":false},"display_eligible":{"const":false},"suitability_claim":{"const":false}}}
  }
}
