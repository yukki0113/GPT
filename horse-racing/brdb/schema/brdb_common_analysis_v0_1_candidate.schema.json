{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yukki0113/GPT/horse-racing/brdb/schema/brdb_common_analysis_v0_1_candidate.schema.json",
  "title": "BRDB PACI field common analysis v0.1 candidate (research only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "release_status",
    "race",
    "as_of_exclusive",
    "sources",
    "policy",
    "horses"
  ],
  "properties": {
    "contract_version": {
      "const": "brdb-common-analysis-v0.1-candidate"
    },
    "release_status": {
      "const": "RESEARCH_ONLY"
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "race_key",
        "target_date",
        "venue_code",
        "surface_code",
        "distance_m",
        "course_code",
        "field_size"
      ],
      "properties": {
        "race_key": {
          "type": "string",
          "pattern": "^[0-9A-Za-z]{8}$"
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "venue_code": {
          "type": "string"
        },
        "surface_code": {
          "enum": [
            "1",
            "2"
          ]
        },
        "distance_m": {
          "type": "integer",
          "minimum": 600
        },
        "course_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "as_of_exclusive": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrated_v03_raw_sha256",
        "relatives_detail_raw_sha256",
        "newspaper_raw_sha256",
        "preview_raw_sha256",
        "source_generations"
      ],
      "properties": {
        "integrated_v03_raw_sha256": {
          "$ref": "#/$defs/sha"
        },
        "relatives_detail_raw_sha256": {
          "$ref": "#/$defs/sha"
        },
        "newspaper_raw_sha256": {
          "$ref": "#/$defs/sha"
        },
        "preview_raw_sha256": {
          "$ref": "#/$defs/sha"
        },
        "source_generations": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction_safe",
        "production_authorized",
        "historical_asof_status",
        "score_included"
      ],
      "properties": {
        "prediction_safe": {
          "const": false
        },
        "production_authorized": {
          "const": false
        },
        "historical_asof_status": {
          "const": "AS_OF_UNVERIFIED"
        },
        "score_included": {
          "const": false
        }
      }
    },
    "horses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/horse"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_key",
        "condition",
        "sample_status",
        "source_generation",
        "as_of_exclusive",
        "counts",
        "rates",
        "baseline",
        "data_status",
        "evidence_id",
        "overlap_group",
        "source_name"
      ],
      "properties": {
        "scope_key": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "venue_code",
            "course_code",
            "surface_code",
            "distance_m",
            "distance_band"
          ],
          "properties": {
            "venue_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "course_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "surface_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "distance_m": {
              "type": [
                "integer",
                "null"
              ]
            },
            "distance_band": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "sample_status": {
          "type": "string"
        },
        "data_status": {
          "enum": [
            "OBSERVED",
            "NO_SAMPLE",
            "SOURCE_UNAVAILABLE"
          ]
        },
        "source_generation": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of_exclusive": {
          "type": "string",
          "format": "date"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "starts",
            "wins",
            "seconds",
            "thirds",
            "out_of_top3",
            "top3",
            "unique_horses"
          ],
          "properties": {
            "starts": {
              "type": "integer",
              "minimum": 0
            },
            "wins": {
              "type": "integer",
              "minimum": 0
            },
            "seconds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "thirds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "out_of_top3": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "top3": {
              "type": "integer",
              "minimum": 0
            },
            "unique_horses": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "rates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "win_rate",
            "top3_rate",
            "win_return_rate",
            "place_return_rate"
          ],
          "properties": {
            "win_rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "top3_rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "win_return_rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "place_return_rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "starts",
            "top3_rate",
            "top3_delta_pp"
          ],
          "properties": {
            "starts": {
              "type": "integer",
              "minimum": 0
            },
            "top3_rate": {
              "type": [
                "number",
                "null"
              ]
            },
            "top3_delta_pp": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "overlap_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "scopes"
      ],
      "properties": {
        "availability": {
          "enum": [
            "AVAILABLE",
            "LOW_SAMPLE",
            "NO_SAMPLE",
            "NOT_IMPLEMENTED",
            "SOURCE_UNAVAILABLE",
            "AS_OF_UNVERIFIED"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "category",
        "interpretation_status",
        "evidence_refs",
        "display_eligible",
        "prediction_eligible"
      ],
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "interpretation_status": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "display_eligible": {
          "type": "boolean"
        },
        "prediction_eligible": {
          "const": false
        }
      }
    },
    "horse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horse_id",
        "horse_no",
        "horse_name",
        "pedigree",
        "components",
        "relatives",
        "findings",
        "status"
      ],
      "properties": {
        "horse_id": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "horse_no": {
          "type": "integer",
          "minimum": 1
        },
        "horse_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "pedigree": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sire_name",
            "dam_name",
            "broodmare_sire_name",
            "sire_line_code",
            "broodmare_sire_line_code"
          ],
          "properties": {
            "sire_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "dam_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "broodmare_sire_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "sire_line_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "broodmare_sire_line_code": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sire",
            "broodmare_sire",
            "pairing",
            "relatives"
          ],
          "properties": {
            "sire": {
              "$ref": "#/$defs/component"
            },
            "broodmare_sire": {
              "$ref": "#/$defs/component"
            },
            "pairing": {
              "$ref": "#/$defs/component"
            },
            "relatives": {
              "$ref": "#/$defs/component"
            }
          }
        },
        "relatives": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "relative_count",
            "zero_start_cells"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "relative_count": {
              "type": "integer",
              "minimum": 0
            },
            "zero_start_cells": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  }
}
