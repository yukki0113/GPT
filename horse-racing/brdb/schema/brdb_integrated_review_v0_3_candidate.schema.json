{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRDB integrated blood review v0.3 candidate / D4 supplemental research attached",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "release_status",
    "race",
    "as_of_exclusive",
    "source_generations",
    "horses",
    "aggregate_coverage",
    "supplemental_research"
  ],
  "properties": {
    "contract_version": {
      "const": "brdb-integrated-blood-review-v0.3-candidate"
    },
    "release_status": {
      "const": "RESEARCH_CANDIDATE"
    },
    "race": {
      "$ref": "#/$defs/race"
    },
    "as_of_exclusive": {
      "$ref": "#/$defs/date"
    },
    "source_generations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brdb",
        "jrdb_analysis",
        "paci"
      ],
      "properties": {
        "brdb": {
          "type": [
            "string",
            "null"
          ]
        },
        "jrdb_analysis": {
          "type": [
            "string",
            "null"
          ]
        },
        "paci": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "horses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/horse"
      },
      "minItems": 1
    },
    "aggregate_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_size",
        "reviewed_horses"
      ],
      "properties": {
        "field_size": {
          "type": "integer",
          "minimum": 1
        },
        "reviewed_horses": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "supplemental_research": {
      "$ref": "#/$defs/supplemental_research"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "availability": {
      "enum": [
        "AVAILABLE",
        "LOW_SAMPLE",
        "NO_SAMPLE",
        "NOT_IMPLEMENTED",
        "SOURCE_UNAVAILABLE",
        "AS_OF_UNVERIFIED"
      ]
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "race_key",
        "target_date",
        "venue_code",
        "surface_code",
        "distance_m",
        "course_code",
        "field_size"
      ],
      "properties": {
        "race_key": {
          "type": "string",
          "pattern": "^[0-9A-Za-z]{8}$"
        },
        "target_date": {
          "$ref": "#/$defs/date"
        },
        "venue_code": {
          "type": "string"
        },
        "surface_code": {
          "enum": [
            "1",
            "2"
          ]
        },
        "distance_m": {
          "type": "integer",
          "minimum": 600,
          "maximum": 5000
        },
        "course_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pedigree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sire_name",
        "dam_name",
        "broodmare_sire_name",
        "sire_line_code",
        "broodmare_sire_line_code"
      ],
      "properties": {
        "sire_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "dam_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "broodmare_sire_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "sire_line_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "broodmare_sire_line_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "evidence_ids"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "venue_code",
        "course_code",
        "surface_code",
        "distance_m",
        "distance_band"
      ],
      "properties": {
        "venue_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "course_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "surface_code": {
          "enum": [
            "1",
            "2",
            null
          ]
        },
        "distance_m": {
          "type": [
            "integer",
            "null"
          ]
        },
        "distance_band": {
          "enum": [
            "SHORT",
            "MILE",
            "MIDDLE",
            "LONG",
            null
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_horses",
        "starts",
        "wins",
        "top3",
        "win_rate",
        "top3_rate",
        "top3_wilson95",
        "baseline_starts",
        "baseline_top3_rate",
        "top3_delta_pp"
      ],
      "properties": {
        "unique_horses": {
          "type": "integer",
          "minimum": 0
        },
        "starts": {
          "type": "integer",
          "minimum": 0
        },
        "wins": {
          "type": "integer",
          "minimum": 0
        },
        "top3": {
          "type": "integer",
          "minimum": 0
        },
        "win_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "top3_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "top3_wilson95": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "items": false
            }
          ]
        },
        "baseline_starts": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_top3_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "top3_delta_pp": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_id",
        "direction",
        "statement",
        "evidence_ids",
        "interpretation_status"
      ],
      "properties": {
        "factor_id": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "UNKNOWN"
          ]
        },
        "statement": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "interpretation_status": {
          "enum": [
            "OBSERVATION_ONLY",
            "HYPOTHESIS_NOT_VALIDATED",
            "VALIDATED_CONDITION_TREND",
            "INSUFFICIENT_EVIDENCE"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "component",
        "evidence_kind",
        "scope_key",
        "condition",
        "observations",
        "sample_status",
        "as_of_exclusive",
        "source_generation",
        "source_name",
        "overlap_group"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "component": {
          "enum": [
            "sire",
            "broodmare_sire",
            "pairing",
            "relatives"
          ]
        },
        "evidence_kind": {
          "enum": [
            "OBSERVED_CONDITIONAL_RESULT",
            "PEDIGREE_FACT",
            "REVIEWED_TAXONOMY"
          ]
        },
        "scope_key": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "observations": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/observation"
            }
          ]
        },
        "sample_status": {
          "enum": [
            "DESCRIPTIVE",
            "LOW_SAMPLE",
            "NO_SAMPLE",
            "NOT_APPLICABLE"
          ]
        },
        "as_of_exclusive": {
          "$ref": "#/$defs/date"
        },
        "source_generation": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "overlap_group": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "horse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horse_id",
        "horse_no",
        "horse_name",
        "status",
        "pedigree_facts",
        "components",
        "evidence",
        "factors",
        "summary",
        "coverage",
        "confidence",
        "supplemental_status",
        "supplemental_insights"
      ],
      "properties": {
        "horse_id": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "horse_no": {
          "type": "integer",
          "minimum": 1
        },
        "horse_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "PARTIAL",
            "INSUFFICIENT_EVIDENCE",
            "NO_PEDIGREE",
            "AS_OF_UNVERIFIED"
          ]
        },
        "pedigree_facts": {
          "$ref": "#/$defs/pedigree"
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sire",
            "broodmare_sire",
            "pairing",
            "relatives"
          ],
          "properties": {
            "sire": {
              "$ref": "#/$defs/component"
            },
            "broodmare_sire": {
              "$ref": "#/$defs/component"
            },
            "pairing": {
              "$ref": "#/$defs/component"
            },
            "relatives": {
              "$ref": "#/$defs/component"
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "factors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "positive",
            "negative",
            "unknown"
          ],
          "properties": {
            "positive": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/factor"
              }
            },
            "negative": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/factor"
              }
            },
            "unknown": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/factor"
              }
            }
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sire",
            "broodmare_sire",
            "pairing",
            "relatives"
          ],
          "properties": {
            "sire": {
              "$ref": "#/$defs/availability"
            },
            "broodmare_sire": {
              "$ref": "#/$defs/availability"
            },
            "pairing": {
              "$ref": "#/$defs/availability"
            },
            "relatives": {
              "$ref": "#/$defs/availability"
            }
          }
        },
        "confidence": {
          "enum": [
            "UNASSESSED",
            "DESCRIPTIVE_ONLY",
            "LIMITED",
            "SUPPORTED"
          ]
        },
        "supplemental_status": {
          "enum": [
            "AS_OF_UNVERIFIED",
            "SOURCE_UNAVAILABLE"
          ]
        },
        "supplemental_insights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplemental_insight"
          }
        }
      }
    },
    "supplemental_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starts",
        "distinct_horses",
        "wins",
        "top3",
        "win_rate",
        "top3_rate",
        "wilson95_top3",
        "baseline_starts",
        "baseline_top3",
        "baseline_top3_rate",
        "top3_delta_percentage_points",
        "sample_status"
      ],
      "properties": {
        "starts": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_horses": {
          "type": "integer",
          "minimum": 0
        },
        "wins": {
          "type": "integer",
          "minimum": 0
        },
        "top3": {
          "type": "integer",
          "minimum": 0
        },
        "win_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "top3_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "wilson95_top3": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "baseline_starts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "baseline_top3": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "baseline_top3_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "top3_delta_percentage_points": {
          "type": [
            "number",
            "null"
          ]
        },
        "sample_status": {
          "enum": [
            "DESCRIPTIVE",
            "LOW_SAMPLE",
            "NO_SAMPLE"
          ]
        }
      }
    },
    "supplemental_condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "track_type": {
          "enum": [
            "1",
            "2"
          ]
        },
        "distance_band": {
          "enum": [
            "SHORT",
            "MILE",
            "MIDDLE",
            "LONG"
          ]
        },
        "distance": {
          "type": "integer",
          "minimum": 600,
          "maximum": 5000
        },
        "venue_code": {
          "type": "string",
          "minLength": 1
        },
        "track_condition_code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supplemental_temporal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "train_starts",
            "test_starts"
          ],
          "properties": {
            "status": {
              "enum": [
                "SAME_SIGN_DESCRIPTIVE_ONLY",
                "DIRECTION_CHANGED",
                "INSUFFICIENT_WINDOW_SAMPLE",
                "PERIOD_MISSING",
                "INSUFFICIENT_BASELINE",
                "NO_DIRECTION"
              ]
            },
            "train_starts": {
              "type": "integer",
              "minimum": 0
            },
            "test_starts": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "supplemental_name": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sire",
            "bms"
          ],
          "properties": {
            "sire": {
              "type": "string",
              "minLength": 1
            },
            "bms": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "supplemental_insight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_lane",
        "source_name_exact",
        "scope_key",
        "condition",
        "observations",
        "temporal_diagnostic",
        "interpretation_status",
        "contribution_to_score"
      ],
      "properties": {
        "source_lane": {
          "enum": [
            "SIRE",
            "BMS",
            "PAIR"
          ]
        },
        "source_name_exact": {
          "$ref": "#/$defs/supplemental_name"
        },
        "scope_key": {
          "enum": [
            "SURFACE",
            "SURFACE_BAND",
            "SURFACE_DISTANCE",
            "VENUE_SURFACE_BAND",
            "SURFACE_GOING_CODE",
            "VENUE_SURFACE_GOING_CODE"
          ]
        },
        "condition": {
          "$ref": "#/$defs/supplemental_condition"
        },
        "observations": {
          "$ref": "#/$defs/supplemental_observations"
        },
        "temporal_diagnostic": {
          "$ref": "#/$defs/supplemental_temporal"
        },
        "interpretation_status": {
          "const": "OBSERVATION_ONLY_AS_OF_UNVERIFIED"
        },
        "contribution_to_score": {
          "type": "null"
        }
      }
    },
    "supplemental_research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sidecar_schema_version",
        "base_review_contract",
        "integrated_review_contract",
        "release_status",
        "research_only",
        "prediction_safe",
        "historical_asof_status",
        "no_forecast_or_score",
        "source_time_guard",
        "source_generations",
        "provenance",
        "aggregate_coverage"
      ],
      "properties": {
        "sidecar_schema_version": {
          "const": "brdb-d4-supplemental-research-v0.1"
        },
        "base_review_contract": {
          "const": "brdb-review-v0.1 (FROZEN, NOT MODIFIED)"
        },
        "integrated_review_contract": {
          "const": "brdb-integrated-blood-review-v0.2-candidate (NOT MODIFIED)"
        },
        "release_status": {
          "const": "RESEARCH_SIDECAR_ONLY"
        },
        "research_only": {
          "const": true
        },
        "prediction_safe": {
          "const": false
        },
        "historical_asof_status": {
          "const": "AS_OF_UNVERIFIED"
        },
        "no_forecast_or_score": {
          "const": true
        },
        "source_time_guard": {
          "type": "string",
          "minLength": 1
        },
        "source_generations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jrdb_analysis",
            "top50_selection"
          ],
          "properties": {
            "jrdb_analysis": {
              "type": "string"
            },
            "top50_selection": {
              "type": "string"
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "d3_full_sha256",
            "d3_temporal_sha256",
            "d3_receipt_sha256",
            "research_field_sha256"
          ],
          "properties": {
            "d3_full_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "d3_temporal_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "d3_receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "research_field_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "aggregate_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field_size",
            "reviewed_horses",
            "research_evidence_items"
          ],
          "properties": {
            "field_size": {
              "type": "integer",
              "minimum": 1
            },
            "reviewed_horses": {
              "type": "integer",
              "minimum": 0
            },
            "research_evidence_items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
