{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SED-normalized historical going rows research interface only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "research_only",
    "prediction_safe",
    "race",
    "as_of_exclusive",
    "source",
    "records"
  ],
  "properties": {
    "contract_version": {
      "const": "brdb-going-observation-input-v0.1-candidate"
    },
    "research_only": {
      "const": true
    },
    "prediction_safe": {
      "const": false
    },
    "race": {
      "type": "object"
    },
    "as_of_exclusive": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader",
        "source_sha256",
        "historical_parent_mapping_status"
      ],
      "properties": {
        "reader": {
          "const": "JRDB_SED_COMMON_READER"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "historical_parent_mapping_status": {
          "enum": [
            "AS_OF_UNVERIFIED",
            "VERIFIED"
          ]
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "race_date",
          "race_key",
          "horse_no",
          "horse_id",
          "surface_code",
          "going_class",
          "sire_name",
          "outcome",
          "finish_position"
        ],
        "properties": {
          "race_date": {
            "type": "string",
            "format": "date"
          },
          "race_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 8
          },
          "horse_no": {
            "type": "integer",
            "minimum": 1
          },
          "horse_id": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          },
          "surface_code": {
            "enum": [
              "1",
              "2"
            ]
          },
          "going_class": {
            "enum": [
              "良",
              "稍重",
              "重",
              "不良"
            ]
          },
          "sire_name": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "FINISHED",
              "EXCLUDED"
            ]
          },
          "finish_position": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    }
  }
}
