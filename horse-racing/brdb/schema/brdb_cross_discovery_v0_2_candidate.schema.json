{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRDB cross-lane discovery v0.2 research candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "release_status",
    "race",
    "as_of_exclusive",
    "policy",
    "horses"
  ],
  "properties": {
    "contract_version": {
      "const": "brdb-cross-discovery-v0.2-candidate"
    },
    "release_status": {
      "const": "RESEARCH_ONLY"
    },
    "race": {
      "type": "object"
    },
    "as_of_exclusive": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction_safe",
        "production_authorized",
        "display_authorized",
        "review_text_generated"
      ],
      "properties": {
        "prediction_safe": {
          "const": false
        },
        "production_authorized": {
          "const": false
        },
        "display_authorized": {
          "const": false
        },
        "review_text_generated": {
          "const": false
        }
      }
    },
    "horses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "horse_no",
          "horse_id",
          "cross_observations",
          "pending"
        ],
        "properties": {
          "horse_no": {
            "type": "integer",
            "minimum": 1
          },
          "horse_id": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          },
          "cross_observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "finding_id",
                "kind",
                "interpretation_status",
                "evidence_refs",
                "scope_key",
                "samples",
                "observed_delta_pp",
                "historical_asof_status",
                "cohort_overlap",
                "causal_claim",
                "suitability_claim",
                "display_eligible",
                "prediction_eligible"
              ],
              "properties": {
                "finding_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "SIRE_BMS_DISTANCE_BAND_COOBSERVATION",
                    "PAIRING_SIRE_SCOPE_COOBSERVATION"
                  ]
                },
                "interpretation_status": {
                  "const": "OBSERVATION_ONLY"
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "scope_key": {
                  "type": "string"
                },
                "samples": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "lane",
                      "starts",
                      "top3",
                      "top3_rate",
                      "sample_status"
                    ],
                    "properties": {
                      "lane": {
                        "enum": [
                          "sire",
                          "broodmare_sire",
                          "pairing"
                        ]
                      },
                      "starts": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "top3": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "top3_rate": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sample_status": {
                        "type": "string"
                      }
                    }
                  }
                },
                "observed_delta_pp": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "historical_asof_status": {
                  "type": "string"
                },
                "cohort_overlap": {
                  "const": "UNKNOWN_OR_POSSIBLE"
                },
                "causal_claim": {
                  "const": false
                },
                "suitability_claim": {
                  "const": false
                },
                "display_eligible": {
                  "const": false
                },
                "prediction_eligible": {
                  "const": false
                }
              }
            }
          },
          "pending": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "reason"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "scope_key": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
