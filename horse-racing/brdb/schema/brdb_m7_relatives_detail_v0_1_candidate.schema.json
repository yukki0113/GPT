{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRDB M7 research-only non-lossy maternal relatives detail sidecar candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "release_status", "research_only", "prediction_safe", "historical_asof_status", "no_forecast_or_score", "source_canonical_sha256", "integrated_v03_canonical_sha256", "source_metadata", "horses", "aggregate_coverage"],
  "properties": {
    "contract_version": {"const": "brdb-m7-relatives-detail-v0.1-candidate"},
    "release_status": {"const": "RESEARCH_SIDECAR_ONLY"},
    "research_only": {"const": true},
    "prediction_safe": {"const": false},
    "historical_asof_status": {"const": "AS_OF_UNVERIFIED"},
    "no_forecast_or_score": {"const": true},
    "source_canonical_sha256": {"$ref": "#/$defs/sha"},
    "integrated_v03_canonical_sha256": {"$ref": "#/$defs/sha"},
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "research_only", "prediction_safe", "pedigree_temporal_status", "race", "pedigree_generation", "analysis_generation", "relationship_policy", "older_birth_only", "as_of_exclusive", "historical_window_start", "sample_policy", "timing_ms"],
      "properties": {
        "version": {"const": "brdb-maternal-relatives-evidence-v0.1"},
        "research_only": {"const": true},
        "prediction_safe": {"const": false},
        "pedigree_temporal_status": {"const": "RESEARCH_PROFILE_DATE_CHECKED_NOT_HISTORICALLY_REPLAYED"},
        "race": {
          "type": "object", "additionalProperties": false,
          "required": ["race_key", "target_date", "venue_code", "surface_code", "distance", "course_code"],
          "properties": {
            "race_key": {"type": "string", "pattern": "^[0-9A-Za-z]{8}$"},
            "target_date": {"type": "string", "format": "date"},
            "venue_code": {"type": "string"},
            "surface_code": {"enum": ["1", "2"]},
            "distance": {"type": "integer", "minimum": 600, "maximum": 5000},
            "course_code": {"type": ["string", "null"]}
          }
        },
        "pedigree_generation": {"type": "string", "minLength": 1},
        "analysis_generation": {"type": "string", "minLength": 1},
        "relationship_policy": {"const": "GUARDED_CANONICAL_DAM_ID_ONLY"},
        "older_birth_only": {"const": true},
        "as_of_exclusive": {"type": "string", "format": "date"},
        "historical_window_start": {"type": "string", "format": "date"},
        "sample_policy": {"const": "NO_RESULTS_IS_NOT_NEGATIVE_APTITUDE"},
        "timing_ms": {
          "type": "object", "additionalProperties": false,
          "required": ["total"],
          "properties": {"total": {"type": "number", "minimum": 0}}
        }
      }
    },
    "horses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/horse"}},
    "aggregate_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["field_size", "reviewed_horses", "mother_roots_resolved", "relative_records", "scope_observations", "zero_start_cells"],
      "properties": {
        "field_size": {"type": "integer", "minimum": 1},
        "reviewed_horses": {"type": "integer", "minimum": 1},
        "mother_roots_resolved": {"type": "integer", "minimum": 0},
        "relative_records": {"type": "integer", "minimum": 0},
        "scope_observations": {"type": "integer", "minimum": 0},
        "zero_start_cells": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[0-9]{8}$"},
    "raw_date": {"type": "string", "pattern": "^[0-9]{8}$"},
    "stat": {
      "type": "object", "additionalProperties": false,
      "required": ["starts", "wins", "top3", "top3_rate"],
      "properties": {
        "starts": {"type": "integer", "minimum": 0},
        "wins": {"type": "integer", "minimum": 0},
        "top3": {"type": "integer", "minimum": 0},
        "top3_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "scopes": {
      "type": "object", "additionalProperties": false,
      "required": ["VENUE_COURSE_EXACT", "VENUE_DISTANCE", "VENUE_BAND", "ALL_VENUES_DISTANCE", "ALL_VENUES_BAND"],
      "properties": {
        "VENUE_COURSE_EXACT": {"$ref": "#/$defs/stat"},
        "VENUE_DISTANCE": {"$ref": "#/$defs/stat"},
        "VENUE_BAND": {"$ref": "#/$defs/stat"},
        "ALL_VENUES_DISTANCE": {"$ref": "#/$defs/stat"},
        "ALL_VENUES_BAND": {"$ref": "#/$defs/stat"}
      }
    },
    "relative": {
      "type": "object", "additionalProperties": false,
      "required": ["horse_id", "horse_name", "relationship", "birth_date", "profile_data_date", "scope_stats", "has_target_surface_band_history"],
      "properties": {
        "horse_id": {"$ref": "#/$defs/id"},
        "horse_name": {"type": ["string", "null"]},
        "relationship": {"enum": ["FULL_SIBLING", "SAME_DAM_SAME_SIRE_NAME_UNVERIFIED", "MATERNAL_HALF_SIBLING", "MATERNAL_AUNT_UNCLE"]},
        "birth_date": {"$ref": "#/$defs/raw_date"},
        "profile_data_date": {"$ref": "#/$defs/raw_date"},
        "scope_stats": {"$ref": "#/$defs/scopes"},
        "has_target_surface_band_history": {"type": "boolean"}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["FULL_SIBLING", "SAME_DAM_SAME_SIRE_NAME_UNVERIFIED", "MATERNAL_HALF_SIBLING", "MATERNAL_AUNT_UNCLE"],
      "properties": {
        "FULL_SIBLING": {"type": "integer", "minimum": 0},
        "SAME_DAM_SAME_SIRE_NAME_UNVERIFIED": {"type": "integer", "minimum": 0},
        "MATERNAL_HALF_SIBLING": {"type": "integer", "minimum": 0},
        "MATERNAL_AUNT_UNCLE": {"type": "integer", "minimum": 0}
      }
    },
    "horse": {
      "type": "object", "additionalProperties": false,
      "required": ["horse_id", "horse_no", "horse_name", "mother_horse_id", "maternal_granddam_horse_id", "status", "relatives", "relative_counts", "with_relevant_starts"],
      "properties": {
        "horse_id": {"$ref": "#/$defs/id"},
        "horse_no": {"type": "integer", "minimum": 1},
        "horse_name": {"type": ["string", "null"]},
        "mother_horse_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "maternal_granddam_horse_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "status": {"enum": ["SOURCE_UNAVAILABLE", "NO_SAMPLE", "DESCRIPTIVE_RELATION"]},
        "relatives": {"type": "array", "items": {"$ref": "#/$defs/relative"}},
        "relative_counts": {"$ref": "#/$defs/counts"},
        "with_relevant_starts": {"type": "integer", "minimum": 0}
      }
    }
  }
}
