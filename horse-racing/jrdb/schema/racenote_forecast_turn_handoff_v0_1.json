{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "racenote_forecast_turn_handoff_v0_1.json",
  "title": "RaceNote Forecast Turn Handoff v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "turn_id",
    "evaluation_mode",
    "logic_version",
    "selected_dates",
    "counts",
    "prediction_artifacts",
    "source_identities",
    "result_opened",
    "execution_observations"
  ],
  "properties": {
    "schema_version": {
      "const": "RaceNote-Forecast-Turn-Handoff-0.1"
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_mode": {
      "enum": [
        "BLINDED_HISTORICAL",
        "TRUE_FORWARD"
      ]
    },
    "logic_version": {
      "type": "string",
      "minLength": 1
    },
    "selected_dates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "total_races",
        "frozen_races",
        "technical_skips"
      ],
      "properties": {
        "total_races": {
          "type": "integer",
          "minimum": 0
        },
        "frozen_races": {
          "type": "integer",
          "minimum": 0
        },
        "technical_skips": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "prediction_artifacts": {
      "type": "object",
      "required": [
        "canonical_records",
        "daily_html"
      ],
      "properties": {
        "canonical_records": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "daily_html": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prediction_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "source_identities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "result_opened": {
      "const": false
    },
    "execution_observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
