{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "racenote_forecast_research_record_v0_4_5.json",
  "title": "RaceNote Forecast Research Record v0.4.5",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "research",
    "source",
    "prediction",
    "decision_trace",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "RaceNote-Forecast-Research-Record-0.4.5"
    },
    "identity": {
      "type": "object",
      "required": [
        "target_date",
        "venue",
        "race_no",
        "race_key"
      ],
      "additionalProperties": true
    },
    "research": {
      "type": "object",
      "required": [
        "evaluation_mode",
        "turn_id",
        "logic_version",
        "prediction_semantics",
        "execution_contract",
        "independent_forecast",
        "baseline_marks_used_as_input"
      ],
      "properties": {
        "evaluation_mode": {
          "enum": [
            "BLINDED_HISTORICAL",
            "TRUE_FORWARD"
          ]
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "logic_version": {
          "const": "RaceNote-Human-Context-Reader-0.4.5-candidate"
        },
        "prediction_semantics": {
          "const": "INHERIT_V0.4.4"
        },
        "execution_contract": {
          "const": "RACENOTE_EXECUTION_V0.4.5"
        },
        "independent_forecast": {
          "const": true
        },
        "baseline_marks_used_as_input": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "racenote_identity",
        "reader_input_policy",
        "reader_chunking"
      ],
      "additionalProperties": true
    },
    "prediction": {
      "type": "object",
      "required": [
        "marks",
        "reader_facing_reason"
      ],
      "properties": {
        "marks": {
          "type": "object",
          "required": [
            "main",
            "second",
            "third",
            "others"
          ],
          "properties": {
            "main": {
              "$ref": "#/$defs/horse_ref"
            },
            "second": {
              "$ref": "#/$defs/horse_ref"
            },
            "third": {
              "$ref": "#/$defs/horse_ref"
            },
            "others": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/horse_ref"
              }
            }
          },
          "additionalProperties": true
        },
        "reader_facing_reason": {
          "type": "string",
          "minLength": 45
        }
      },
      "additionalProperties": true
    },
    "decision_trace": {
      "type": "object",
      "required": [
        "race_model",
        "mainline_cases",
        "single_shot_case",
        "mark_reason",
        "rrdb_evidence",
        "consistency_pass"
      ],
      "properties": {
        "race_model": {
          "type": "string",
          "minLength": 30
        },
        "mainline_cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "horse",
              "case"
            ],
            "properties": {
              "horse": {
                "$ref": "#/$defs/horse_ref"
              },
              "case": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "single_shot_case": {
          "type": "object",
          "required": [
            "horse",
            "selected_independently_from_mainline",
            "case"
          ],
          "properties": {
            "horse": {
              "$ref": "#/$defs/horse_ref"
            },
            "selected_independently_from_mainline": {
              "const": true
            },
            "case": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "mark_reason": {
          "type": "object",
          "required": [
            "model_authored_reason"
          ],
          "additionalProperties": true
        },
        "rrdb_evidence": {
          "type": "object",
          "required": [
            "available",
            "reviewed",
            "used_in_decision",
            "horse_refs",
            "reason_not_used"
          ],
          "additionalProperties": true
        },
        "consistency_pass": {
          "type": "object",
          "required": [
            "hierarchy_reviewed",
            "hierarchy_changed",
            "single_shot_promotion_reviewed",
            "single_shot_promoted",
            "coverage_scan_reviewed",
            "coverage_scan",
            "coverage_best_challenger",
            "coverage_boundary",
            "coverage_verdict",
            "coverage_changed",
            "coverage_reason",
            "change_attribution"
          ],
          "properties": {
            "hierarchy_reviewed": {
              "const": true
            },
            "hierarchy_changed": {
              "type": "boolean"
            },
            "hierarchy_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "single_shot_promotion_reviewed": {
              "const": true
            },
            "single_shot_promoted": {
              "type": "boolean"
            },
            "single_shot_promotion_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "coverage_scan_reviewed": {
              "const": true
            },
            "coverage_scan": {
              "type": "object",
              "required": [
                "unmarked_count",
                "shortlisted_horse_nos"
              ],
              "properties": {
                "unmarked_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "shortlisted_horse_nos": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "additionalProperties": true
            },
            "coverage_best_challenger": {
              "anyOf": [
                {
                  "$ref": "#/$defs/horse_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "coverage_boundary": {
              "type": "object",
              "required": [
                "current_delta2",
                "direct_condition_comparison",
                "ability_comparison",
                "race_model_comparison"
              ],
              "properties": {
                "current_delta2": {
                  "$ref": "#/$defs/horse_ref"
                },
                "direct_condition_comparison": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/comparison_label"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ability_comparison": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/comparison_label"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "race_model_comparison": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/comparison_label"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": true
            },
            "coverage_verdict": {
              "enum": [
                "KEEP",
                "SWAP",
                "NO_ELIGIBLE_CHALLENGER"
              ]
            },
            "coverage_changed": {
              "type": "boolean"
            },
            "coverage_reason": {
              "type": "string",
              "minLength": 8
            },
            "change_attribution": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "required": [
        "pre_result_guard",
        "result_visible_at_freeze",
        "decision_core_sha256"
      ],
      "properties": {
        "pre_result_guard": {
          "const": "PASS"
        },
        "result_visible_at_freeze": {
          "const": false
        },
        "decision_core_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "horse_ref": {
      "type": "object",
      "required": [
        "horse_no",
        "horse_name"
      ],
      "properties": {
        "horse_no": {
          "type": "integer",
          "minimum": 1
        },
        "horse_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "comparison_label": {
      "enum": [
        "CHALLENGER_STRONGER",
        "DELTA2_STRONGER",
        "ROUGHLY_EQUAL",
        "UNCLEAR"
      ]
    }
  },
  "additionalProperties": true
}
