{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "racenote_pairwise_comparison_schema_v0_1.json",
  "title": "RaceNote Pairwise Comparison v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pairwise_schema_version",
    "pairwise_contract_version",
    "general_evidence_sha256",
    "target",
    "draft_order",
    "comparisons",
    "final_order",
    "final_order_summary"
  ],
  "properties": {
    "pairwise_schema_version": {
      "const": "RaceNote-Pairwise-Comparison-0.1"
    },
    "pairwise_contract_version": {
      "const": "TrendFirst-Pairwise-v0.1"
    },
    "general_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "required": ["date", "venue", "race_no", "race_name"],
      "properties": {
        "date": {"type": "string"},
        "venue": {"type": "string", "minLength": 1},
        "race_no": {"type": "integer", "minimum": 1},
        "race_name": {"type": "string"}
      },
      "additionalProperties": false
    },
    "draft_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/comparison"}
    },
    "final_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "final_order_summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "laneJudgment": {
      "type": "object",
      "required": [
        "relation",
        "summary",
        "evidence_codes",
        "source_refs"
      ],
      "properties": {
        "relation": {
          "enum": ["A", "B", "EVEN", "UNKNOWN"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "horse_a",
        "horse_b",
        "lane_judgments",
        "preference",
        "confidence",
        "decisive_lane",
        "lower_priority_override",
        "override_reason",
        "comparison_summary",
        "reversal_conditions"
      ],
      "properties": {
        "horse_a": {"type": "integer", "minimum": 1},
        "horse_b": {"type": "integer", "minimum": 1},
        "lane_judgments": {
          "type": "object",
          "required": [
            "DATA_TREND",
            "RACEREVIEW",
            "ABILITY_ANCHOR"
          ],
          "properties": {
            "DATA_TREND": {"$ref": "#/$defs/laneJudgment"},
            "RACEREVIEW": {"$ref": "#/$defs/laneJudgment"},
            "ABILITY_ANCHOR": {"$ref": "#/$defs/laneJudgment"}
          },
          "additionalProperties": false
        },
        "preference": {"enum": ["A", "B"]},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "decisive_lane": {
          "enum": [
            "DATA_TREND",
            "RACEREVIEW",
            "ABILITY_ANCHOR",
            "MIXED",
            "UNCERTAINTY"
          ]
        },
        "lower_priority_override": {"type": "boolean"},
        "override_reason": {"type": "string"},
        "comparison_summary": {
          "type": "string",
          "minLength": 1
        },
        "reversal_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
