{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "racenote_forecast_research_record_v0_3_1.json",
  "title": "RaceNote Forecast Research Record v0.3.1 Human Context + RRDB",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "research",
    "source",
    "prediction",
    "decision_trace",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "RaceNote-Forecast-Research-Record-0.3.1"
    },
    "identity": {
      "type": "object",
      "required": [
        "target_date",
        "venue",
        "race_no",
        "race_key"
      ],
      "properties": {
        "target_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "race_no": {
          "type": "integer",
          "minimum": 1
        },
        "race_key": {
          "type": "string",
          "minLength": 1
        },
        "race_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "surface": {
          "type": [
            "string",
            "null"
          ]
        },
        "distance_m": {
          "type": [
            "integer",
            "null"
          ]
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "research": {
      "type": "object",
      "required": [
        "evaluation_mode",
        "turn_id",
        "logic_version"
      ],
      "properties": {
        "evaluation_mode": {
          "enum": [
            "CALIBRATION_REPLAY",
            "BLINDED_HISTORICAL",
            "TRUE_FORWARD"
          ]
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "logic_version": {
          "const": "RaceNote-Human-Context-Reader-0.3"
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "racenote_identity"
      ],
      "properties": {
        "racenote_identity": {
          "type": "string",
          "minLength": 1
        },
        "racenote_semantic_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "prediction": {
      "type": "object",
      "required": [
        "axis",
        "marks",
        "axis_comment",
        "concern"
      ],
      "properties": {
        "axis": {
          "$ref": "#/$defs/horse_ref"
        },
        "marks": {
          "type": "object",
          "required": [
            "main",
            "second",
            "third",
            "others"
          ],
          "properties": {
            "main": {
              "$ref": "#/$defs/horse_ref"
            },
            "second": {
              "$ref": "#/$defs/horse_ref"
            },
            "third": {
              "$ref": "#/$defs/horse_ref"
            },
            "others": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/horse_ref"
              }
            }
          },
          "additionalProperties": true
        },
        "axis_comment": {
          "type": "string",
          "minLength": 20
        },
        "concern": {
          "type": "string",
          "minLength": 10
        },
        "full_field_order": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/horse_ref"
          }
        }
      },
      "additionalProperties": true
    },
    "decision_trace": {
      "type": "object",
      "required": [
        "human_principles_used",
        "race_model",
        "primary_question",
        "candidate_cases",
        "main_vs_second",
        "main_vs_third",
        "why_not_numeric_leader",
        "strongest_counter",
        "reversal_condition",
        "rrdb_evidence"
      ],
      "properties": {
        "human_principles_used": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "enum": [
              "H1",
              "H2",
              "H3",
              "H4",
              "H5",
              "H6",
              "H7"
            ]
          }
        },
        "race_model": {
          "type": "string",
          "minLength": 30
        },
        "primary_question": {
          "type": "string",
          "minLength": 15
        },
        "candidate_cases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/candidate_case"
          }
        },
        "main_vs_second": {
          "$ref": "#/$defs/direct_comparison"
        },
        "main_vs_third": {
          "$ref": "#/$defs/direct_comparison"
        },
        "why_not_numeric_leader": {
          "type": "string",
          "minLength": 20
        },
        "strongest_counter": {
          "type": "string",
          "minLength": 15
        },
        "reversal_condition": {
          "type": "string",
          "minLength": 15
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "rrdb_evidence": {
          "type": "object",
          "required": [
            "available",
            "reviewed",
            "used_in_decision",
            "horse_refs",
            "reason_not_used"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "reviewed": {
              "type": "boolean"
            },
            "used_in_decision": {
              "type": "boolean"
            },
            "horse_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "horse_no",
                  "horse_name",
                  "decision_role"
                ],
                "properties": {
                  "horse_no": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "horse_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_run_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "next_watch_grade": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "S",
                      "A",
                      null
                    ]
                  },
                  "matched_rule_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "decision_role": {
                    "enum": [
                      "UPGRADE_RECENT_FORM",
                      "DOWNGRADE_APPARENT_FORM",
                      "SUPPORT_REPEATABILITY",
                      "SUPPORT_COUNTERARGUMENT",
                      "CONTEXT_ONLY"
                    ]
                  }
                },
                "additionalProperties": true
              }
            },
            "reason_not_used": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "required": [
        "created_at",
        "frozen_at",
        "prediction_hash",
        "pre_result_guard",
        "result_visible_at_freeze",
        "human_context_guard"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "frozen_at": {
          "type": "string",
          "minLength": 1
        },
        "prediction_hash": {
          "type": "string",
          "minLength": 1
        },
        "pre_result_guard": {
          "const": "PASS"
        },
        "result_visible_at_freeze": {
          "const": false
        },
        "human_context_guard": {
          "const": "PASS"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "horse_ref": {
      "type": "object",
      "required": [
        "horse_no",
        "horse_name"
      ],
      "properties": {
        "horse_no": {
          "type": "integer",
          "minimum": 1
        },
        "horse_name": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "candidate_case": {
      "type": "object",
      "required": [
        "horse",
        "case_for",
        "case_against",
        "context_hook"
      ],
      "properties": {
        "horse": {
          "$ref": "#/$defs/horse_ref"
        },
        "case_for": {
          "type": "string",
          "minLength": 15
        },
        "case_against": {
          "type": "string",
          "minLength": 10
        },
        "context_hook": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": true
    },
    "direct_comparison": {
      "type": "object",
      "required": [
        "preferred",
        "other",
        "reason"
      ],
      "properties": {
        "preferred": {
          "$ref": "#/$defs/horse_ref"
        },
        "other": {
          "$ref": "#/$defs/horse_ref"
        },
        "reason": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
