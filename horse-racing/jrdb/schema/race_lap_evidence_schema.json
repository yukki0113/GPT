{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logic_version",
    "race",
    "coverage",
    "laps",
    "shape",
    "srb_context",
    "provenance",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "JRDB-Race-Lap-Evidence-0.1"
    },
    "logic_version": {
      "const": "SRB-Neutral-RaceShape-v0.1"
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "race_key",
        "race_date",
        "surface_code",
        "distance_m"
      ],
      "properties": {
        "race_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8
        },
        "race_date": {
          "type": "string",
          "format": "date"
        },
        "surface_code": {
          "type": "string",
          "minLength": 1
        },
        "distance_m": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "lap_count",
        "comparable_200m_lap_count",
        "partial_first_segment",
        "early_late_delta_available",
        "optional_srb_context_available"
      ],
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "NO_LAPS"
          ]
        },
        "lap_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "comparable_200m_lap_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "partial_first_segment": {
          "type": "boolean"
        },
        "early_late_delta_available": {
          "type": "boolean"
        },
        "optional_srb_context_available": {
          "type": "boolean"
        }
      }
    },
    "laps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "individual_horse_sectionals",
        "segment_distances_m",
        "lap_times_sec",
        "segments"
      ],
      "properties": {
        "basis": {
          "const": "LEADER_SECTIONALS"
        },
        "individual_horse_sectionals": {
          "const": false
        },
        "segment_distances_m": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "maxItems": 18
        },
        "lap_times_sec": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxItems": 18
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_no",
              "start_m",
              "end_m",
              "segment_distance_m",
              "lap_sec"
            ],
            "properties": {
              "segment_no": {
                "type": "integer",
                "minimum": 1
              },
              "start_m": {
                "type": "integer",
                "minimum": 0
              },
              "end_m": {
                "type": "integer",
                "minimum": 1
              },
              "segment_distance_m": {
                "type": "integer",
                "minimum": 1
              },
              "lap_sec": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "maxItems": 18
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "early3f_sec",
        "late3f_sec",
        "early_late_delta_sec",
        "lap_std_sec",
        "lap_range_sec",
        "fastest_lap_sec",
        "fastest_segment_no",
        "max_accel_sec",
        "max_decel_sec",
        "last_vs_best_sec",
        "last3_slope_sec_per_segment",
        "pace_up_remaining_furlongs"
      ],
      "properties": {
        "early3f_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "late3f_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "early_late_delta_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "lap_std_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "lap_range_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "fastest_lap_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "fastest_segment_no": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_accel_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_decel_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "last_vs_best_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "last3_slope_sec_per_segment": {
          "type": [
            "number",
            "null"
          ]
        },
        "pace_up_remaining_furlongs": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "srb_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_bias",
        "race_comment"
      ],
      "properties": {
        "track_bias": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "race_comment": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "archive",
        "sed_member",
        "srb_member",
        "dataset_schema_version"
      ],
      "properties": {
        "source_kind": {
          "const": "JRDB_SRB"
        },
        "archive": {
          "type": "string",
          "minLength": 1
        },
        "sed_member": {
          "type": "string",
          "minLength": 1
        },
        "srb_member": {
          "type": "string",
          "minLength": 1
        },
        "dataset_schema_version": {
          "const": "JRDB-Race-Lap-Parquet-0.1"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leader_based",
        "individual_sectionals",
        "score_status",
        "target_race_usage",
        "partial_first_segment_policy"
      ],
      "properties": {
        "leader_based": {
          "const": true
        },
        "individual_sectionals": {
          "const": false
        },
        "score_status": {
          "const": "NO_ADDITIVE_SCORE"
        },
        "target_race_usage": {
          "const": "HISTORICAL_ONLY_AS_OF_EXCLUSIVE"
        },
        "partial_first_segment_policy": {
          "const": "EXCLUDE_FROM_200M_COMPARABLE_METRICS"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "race_lap_evidence_schema.json",
  "title": "JRDB Race Lap Evidence v0.1",
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage": {
            "properties": {
              "status": {
                "const": "NO_LAPS"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "lap_count": {
                "const": 0
              },
              "comparable_200m_lap_count": {
                "const": 0
              },
              "partial_first_segment": {
                "const": false
              },
              "early_late_delta_available": {
                "const": false
              }
            }
          },
          "laps": {
            "properties": {
              "segment_distances_m": {
                "maxItems": 0
              },
              "lap_times_sec": {
                "maxItems": 0
              },
              "segments": {
                "maxItems": 0
              }
            }
          },
          "shape": {
            "properties": {
              "early3f_sec": {
                "type": "null"
              },
              "late3f_sec": {
                "type": "null"
              },
              "early_late_delta_sec": {
                "type": "null"
              },
              "lap_std_sec": {
                "type": "null"
              },
              "lap_range_sec": {
                "type": "null"
              },
              "fastest_lap_sec": {
                "type": "null"
              },
              "fastest_segment_no": {
                "type": "null"
              },
              "max_accel_sec": {
                "type": "null"
              },
              "max_decel_sec": {
                "type": "null"
              },
              "last_vs_best_sec": {
                "type": "null"
              },
              "last3_slope_sec_per_segment": {
                "type": "null"
              },
              "pace_up_remaining_furlongs": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "coverage": {
            "properties": {
              "lap_count": {
                "minimum": 1
              }
            }
          },
          "laps": {
            "properties": {
              "segment_distances_m": {
                "minItems": 1
              },
              "lap_times_sec": {
                "minItems": 1
              },
              "segments": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
