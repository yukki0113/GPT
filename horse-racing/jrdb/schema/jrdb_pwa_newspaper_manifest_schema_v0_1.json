{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jrdb_pwa_newspaper_manifest_schema_v0_1.json",
  "title": "JRDB PWA Newspaper Daily Manifest v0.1",
  "description": "Draft daily manifest for incremental newspaper PWA delivery.",
  "type": "object",
  "required": ["schema_version", "manifest_kind", "date", "revision", "generated_at", "source_status", "completeness", "races"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "manifest_kind": {"const": "jrdb_pwa_newspaper_daily_manifest"},
    "date": {"type": "string", "format": "date"},
    "revision": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string"},
    "source_status": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sourceState"}
    },
    "completeness": {"$ref": "#/$defs/completeness"},
    "races": {
      "type": "array",
      "items": {"$ref": "#/$defs/raceEntry"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sourceState": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["READY", "PARTIAL", "PENDING", "NOT_APPLICABLE", "ERROR"]},
        "source_version": {"type": ["string", "null"]},
        "generated_at": {"type": ["string", "null"]},
        "message": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "completeness": {
      "type": "object",
      "required": ["expected_races", "ready_races"],
      "properties": {
        "expected_races": {"type": "integer", "minimum": 0},
        "ready_races": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "raceEntry": {
      "type": "object",
      "required": ["race_key", "venue_code", "venue", "race_no", "path", "revision", "sha256", "size_bytes"],
      "properties": {
        "race_key": {"type": "string"},
        "venue_code": {"type": "string"},
        "venue": {"type": "string"},
        "race_no": {"type": "integer", "minimum": 1, "maximum": 12},
        "race_name": {"type": ["string", "null"]},
        "start_time": {"type": ["string", "null"]},
        "path": {"type": "string"},
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  }
}
