{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "racenote_btday_v046_request.json",
  "title": "RaceNote BTDAY v0.4.6 Preparation Request",
  "type": "object",
  "required": [
    "selection_id",
    "target_date",
    "paci_file_id",
    "analysis_artifact_run_id",
    "analysis_artifact_name",
    "analysis_generation_id"
  ],
  "properties": {
    "selection_id": {
      "type": "string",
      "pattern": "^BTDAY-[0-9]{4}$"
    },
    "target_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "paci_file_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_artifact_run_id": {
      "type": "integer",
      "minimum": 1
    },
    "analysis_artifact_name": {
      "type": "string",
      "minLength": 1
    },
    "analysis_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "rrdb_file_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_watch_file_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
