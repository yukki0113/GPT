{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "racenote_forecast_research_record_v0_1.json",
  "title": "RaceNote Forecast Research Record v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "research",
    "source",
    "prediction",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "RaceNote-Forecast-Research-Record-0.1"
    },
    "identity": {
      "type": "object",
      "required": [
        "target_date",
        "venue",
        "race_no",
        "race_key"
      ],
      "properties": {
        "target_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "race_no": {
          "type": "integer",
          "minimum": 1
        },
        "race_key": {
          "type": "string",
          "minLength": 1
        },
        "race_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "surface": {
          "type": [
            "string",
            "null"
          ]
        },
        "distance_m": {
          "type": [
            "integer",
            "null"
          ]
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "research": {
      "type": "object",
      "required": [
        "evaluation_mode",
        "turn_id",
        "logic_version"
      ],
      "properties": {
        "evaluation_mode": {
          "enum": [
            "BLINDED_HISTORICAL",
            "TRUE_FORWARD"
          ]
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "logic_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "racenote_identity"
      ],
      "properties": {
        "racenote_identity": {
          "type": "string",
          "minLength": 1
        },
        "racenote_semantic_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "prediction": {
      "type": "object",
      "required": [
        "axis",
        "marks",
        "axis_comment"
      ],
      "properties": {
        "axis": {
          "$ref": "#/$defs/horse_ref"
        },
        "marks": {
          "type": "object",
          "required": [
            "main"
          ],
          "properties": {
            "main": {
              "$ref": "#/$defs/horse_ref"
            },
            "second": {
              "anyOf": [
                {
                  "$ref": "#/$defs/horse_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "third": {
              "anyOf": [
                {
                  "$ref": "#/$defs/horse_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "others": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/horse_ref"
              }
            }
          },
          "additionalProperties": true
        },
        "axis_comment": {
          "type": "string"
        },
        "concern": {
          "type": [
            "string",
            "null"
          ]
        },
        "full_field_order": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/horse_ref"
          }
        },
        "candidate_trace": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "required": [
        "created_at",
        "frozen_at",
        "prediction_hash",
        "pre_result_guard",
        "result_visible_at_freeze"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "frozen_at": {
          "type": "string",
          "minLength": 1
        },
        "prediction_hash": {
          "type": "string",
          "minLength": 1
        },
        "pre_result_guard": {
          "const": "PASS"
        },
        "result_visible_at_freeze": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "horse_ref": {
      "type": "object",
      "required": [
        "horse_no",
        "horse_name"
      ],
      "properties": {
        "horse_no": {
          "type": "integer",
          "minimum": 1
        },
        "horse_name": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
