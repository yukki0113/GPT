{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "racenote_decision_core_v0_4_6.json",
  "title": "RaceNote Decision Core v0.4.6",
  "type": "object",
  "required": [
    "venue",
    "race_no",
    "race_model",
    "marks",
    "mainline_cases",
    "single_shot_case",
    "boundary_review",
    "rrdb_refs",
    "reader_facing_reason"
  ],
  "properties": {
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "race_no": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "race_model": {
      "type": "string",
      "minLength": 30
    },
    "marks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "mainline_cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "horse_no",
          "case"
        ],
        "properties": {
          "horse_no": {
            "type": "integer",
            "minimum": 1
          },
          "case": {
            "type": "string",
            "minLength": 8
          }
        },
        "additionalProperties": false
      }
    },
    "single_shot_case": {
      "type": "object",
      "required": [
        "horse_no",
        "case"
      ],
      "properties": {
        "horse_no": {
          "type": "integer",
          "minimum": 1
        },
        "case": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": false
    },
    "boundary_review": {
      "type": "object",
      "required": [
        "alternative_horse_no",
        "reason"
      ],
      "properties": {
        "alternative_horse_no": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": false
    },
    "rrdb_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "horse_no",
          "decision_role"
        ],
        "properties": {
          "horse_no": {
            "type": "integer",
            "minimum": 1
          },
          "decision_role": {
            "enum": [
              "UPGRADE_RECENT_FORM",
              "DOWNGRADE_APPARENT_FORM",
              "SUPPORT_REPEATABILITY",
              "SUPPORT_COUNTERARGUMENT",
              "CONTEXT_ONLY"
            ]
          }
        },
        "additionalProperties": false
      },
      "description": "Sparse audit refs only for horses whose RRDB evidence materially changed or sharpened the final judgment. This is not a list of every reviewed horse or every marked horse."
    },
    "reader_facing_reason": {
      "type": "string",
      "minLength": 45,
      "description": "One natural newspaper-style race comment. Do not serialize marks mechanically or expose internal evidence-source terminology when ordinary racing language conveys the point."
    }
  },
  "additionalProperties": false
}
