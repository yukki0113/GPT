{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "racenote_general_evidence_schema_v0_1.json",
  "title": "RaceNote General Evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "general_schema_version",
    "general_logic_version",
    "target",
    "priority_policy",
    "firewall",
    "race_data_context",
    "race_structure",
    "horses",
    "next_stage"
  ],
  "properties": {
    "general_schema_version": {
      "const": "RaceNote-General-Evidence-0.1"
    },
    "general_logic_version": {
      "const": "TrendFirst-RR-AbilityAnchor-v0.1"
    },
    "target": {
      "type": "object",
      "required": [
        "date",
        "venue",
        "race_no",
        "race_name"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "venue": {
          "type": "string"
        },
        "race_no": {
          "type": "integer",
          "minimum": 1
        },
        "race_name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "priority_policy": {
      "type": "object",
      "required": [
        "relation",
        "decision_order",
        "numeric_weights",
        "rules"
      ],
      "properties": {
        "relation": {
          "const": "DATA_TREND > RACEREVIEW >= ABILITY_ANCHOR"
        },
        "decision_order": {
          "const": [
            "DATA_TREND",
            "RACEREVIEW",
            "ABILITY_ANCHOR"
          ]
        },
        "numeric_weights": {
          "type": "null"
        },
        "rules": {
          "type": "object",
          "required": [
            "data_trend_read_first",
            "racereview_read_second",
            "ability_anchor_read_last",
            "ability_may_auto_rank",
            "lower_priority_override_requires_reason",
            "higher_priority_missing_is_not_negative",
            "small_sample_must_remain_visible",
            "contradictions_must_be_preserved"
          ],
          "properties": {
            "data_trend_read_first": {
              "const": true
            },
            "racereview_read_second": {
              "const": true
            },
            "ability_anchor_read_last": {
              "const": true
            },
            "ability_may_auto_rank": {
              "const": false
            },
            "lower_priority_override_requires_reason": {
              "const": true
            },
            "higher_priority_missing_is_not_negative": {
              "const": true
            },
            "small_sample_must_remain_visible": {
              "const": true
            },
            "contradictions_must_be_preserved": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "firewall": {
      "type": "object",
      "required": [
        "current_jrdb_consensus_visible",
        "current_market_visible",
        "training_edge_visible"
      ],
      "properties": {
        "current_jrdb_consensus_visible": {
          "const": false
        },
        "current_market_visible": {
          "const": false
        },
        "training_edge_visible": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "race_data_context": {
      "type": "object",
      "required": [
        "conditions",
        "available_trends",
        "trend_sources_v0_1",
        "independent_future_trend_sources",
        "post_freeze_trend_sources",
        "policy"
      ],
      "properties": {
        "conditions": {
          "type": "object"
        },
        "available_trends": {
          "type": "object"
        },
        "trend_sources_v0_1": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "independent_future_trend_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "post_freeze_trend_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy": {
          "type": "object"
        },
        "race_day_facts": {
          "type": "object",
          "required": [
            "status",
            "source_kind",
            "as_of",
            "weather",
            "track_condition",
            "policy"
          ],
          "properties": {
            "status": {
              "enum": [
                "AVAILABLE",
                "UNAVAILABLE"
              ]
            },
            "source_kind": {
              "type": [
                "string",
                "null"
              ]
            },
            "as_of": {
              "type": [
                "string",
                "null"
              ]
            },
            "weather": {
              "type": [
                "string",
                "null"
              ]
            },
            "track_condition": {
              "type": [
                "string",
                "null"
              ]
            },
            "policy": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "race_structure": {
      "type": "object",
      "required": [
        "structure_version",
        "status",
        "pace_pressure",
        "front_or_forward_tendency_count",
        "known_position_profile_count",
        "runner_count",
        "horses",
        "policy"
      ],
      "properties": {
        "structure_version": {
          "const": "IndependentRaceStructure-v0.1"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "INSUFFICIENT_HISTORY"
          ]
        },
        "pace_pressure": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "front_or_forward_tendency_count": {
          "type": "integer",
          "minimum": 0
        },
        "known_position_profile_count": {
          "type": "integer",
          "minimum": 0
        },
        "runner_count": {
          "type": "integer",
          "minimum": 1
        },
        "horses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "horse_no",
              "horse_name",
              "historical_position"
            ],
            "properties": {
              "horse_no": {
                "type": "integer",
                "minimum": 1
              },
              "horse_name": {
                "type": "string"
              },
              "historical_position": {
                "type": "object",
                "required": [
                  "status",
                  "source",
                  "observed_run_count",
                  "band_counts",
                  "tendency",
                  "confidence",
                  "observations",
                  "policy"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "AVAILABLE",
                      "UNAVAILABLE"
                    ]
                  },
                  "source": {
                    "const": "RECENT_RUN_CORNER_HISTORY_ONLY"
                  },
                  "observed_run_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "band_counts": {
                    "type": "object"
                  },
                  "tendency": {
                    "enum": [
                      "FRONT",
                      "FORWARD",
                      "MID",
                      "BACK",
                      "UNKNOWN"
                    ]
                  },
                  "confidence": {
                    "enum": [
                      "NONE",
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  },
                  "observations": {
                    "type": "array"
                  },
                  "policy": {
                    "type": "object"
                  },
                  "dominant_band_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "dominant_share": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "distinct_band_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "variability_status": {
                    "enum": [
                      "UNAVAILABLE",
                      "SINGLE_BAND",
                      "MULTI_BAND"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "policy": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "horses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/horse"
      }
    },
    "next_stage": {
      "type": "object",
      "required": [
        "name",
        "required_read_order",
        "status",
        "contract_version"
      ],
      "properties": {
        "name": {
          "const": "ALL_RUNNER_SYNTHESIS"
        },
        "required_read_order": {
          "const": [
            "DATA_TREND",
            "RACEREVIEW",
            "ABILITY_ANCHOR"
          ]
        },
        "status": {
          "const": "CONTRACT_IMPLEMENTED"
        },
        "contract_version": {
          "const": "FullField-Draft-v0.1"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "trendObservation": {
      "type": "object",
      "required": [
        "code",
        "label",
        "redundancy_group_id",
        "direction",
        "sample_size_band",
        "condition",
        "career_baseline",
        "delta_pp",
        "interpretation_status"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "redundancy_group_id": {
          "enum": [
            "SURFACE",
            "DISTANCE",
            "VENUE"
          ]
        },
        "direction": {
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "NEUTRAL",
            "UNKNOWN"
          ]
        },
        "sample_size_band": {
          "enum": [
            "none",
            "small",
            "moderate",
            "sufficient"
          ]
        },
        "condition": {
          "type": "object"
        },
        "career_baseline": {
          "type": "object"
        },
        "delta_pp": {
          "type": "object"
        },
        "interpretation_status": {
          "const": "OBSERVED_RATE_DIFFERENCE_NOT_CAUSAL"
        }
      },
      "additionalProperties": false
    },
    "horseHistory": {
      "type": "object",
      "required": [
        "status",
        "observations",
        "source"
      ],
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_window_start": {
          "type": "string"
        },
        "as_of_exclusive": {
          "type": "string"
        },
        "career": {
          "type": "object"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trendObservation"
          }
        }
      },
      "additionalProperties": true
    },
    "statContext": {
      "type": "object",
      "required": [
        "code",
        "status"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "frame_no": {},
        "sample_size_band": {
          "enum": [
            "none",
            "small",
            "moderate",
            "sufficient"
          ]
        },
        "summary": {
          "type": "object"
        },
        "interpretation_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dataTrend": {
      "type": "object",
      "required": [
        "priority_rank",
        "priority_relation",
        "horse_history",
        "population_context",
        "policy"
      ],
      "properties": {
        "priority_rank": {
          "const": 1
        },
        "priority_relation": {
          "const": "HIGHEST"
        },
        "horse_history": {
          "$ref": "#/$defs/horseHistory"
        },
        "population_context": {
          "type": "object",
          "required": [
            "frame",
            "sire",
            "jockey"
          ],
          "properties": {
            "frame": {
              "$ref": "#/$defs/statContext"
            },
            "sire": {
              "$ref": "#/$defs/statContext"
            },
            "jockey": {
              "$ref": "#/$defs/statContext"
            }
          },
          "additionalProperties": false
        },
        "policy": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "raceReview": {
      "type": "object",
      "required": [
        "priority_rank",
        "priority_relation",
        "card_scope",
        "source_run_contexts",
        "primary_positive",
        "supporting_positive",
        "concerns",
        "mixed_context",
        "profile",
        "uncertainties",
        "comment_evidence"
      ],
      "properties": {
        "priority_rank": {
          "const": 2
        },
        "priority_relation": {
          "const": "SECOND"
        },
        "card_scope": {
          "type": "string"
        },
        "source_run_contexts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "primary_positive": {
          "type": "array"
        },
        "supporting_positive": {
          "type": "array"
        },
        "concerns": {
          "type": "array"
        },
        "mixed_context": {
          "type": "array"
        },
        "profile": {
          "type": "object"
        },
        "uncertainties": {
          "type": "array"
        },
        "comment_evidence": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "abilityAnchor": {
      "type": "object",
      "required": [
        "priority_rank",
        "priority_relation",
        "status",
        "observed_count",
        "observations",
        "profile",
        "policy"
      ],
      "properties": {
        "priority_rank": {
          "const": 3
        },
        "priority_relation": {
          "const": "ANCHOR_ONLY"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0
        },
        "observations": {
          "type": "array"
        },
        "profile": {
          "type": "object",
          "required": [
            "latest",
            "peak",
            "typical_median",
            "minimum",
            "mad"
          ]
        },
        "policy": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "trendInterpretation": {
      "type": "object",
      "required": [
        "state",
        "positive",
        "negative",
        "neutral",
        "unknown",
        "best_directional_sample_band",
        "small_sample_only",
        "population_contexts",
        "reading_rule"
      ],
      "properties": {
        "state": {
          "enum": [
            "SUPPORTIVE",
            "OPPOSED",
            "MIXED",
            "NEUTRAL_OR_UNKNOWN",
            "INSUFFICIENT"
          ]
        },
        "positive": {
          "type": "array"
        },
        "negative": {
          "type": "array"
        },
        "neutral": {
          "type": "array"
        },
        "unknown": {
          "type": "array"
        },
        "best_directional_sample_band": {
          "enum": [
            "none",
            "small",
            "moderate",
            "sufficient"
          ]
        },
        "small_sample_only": {
          "type": "boolean"
        },
        "population_contexts": {
          "type": "array"
        },
        "reading_rule": {
          "const": "DIRECTION_PLUS_SAMPLE_SIZE_BEFORE_POPULATION_CONTEXT"
        }
      },
      "additionalProperties": false
    },
    "reviewTransferability": {
      "type": "object",
      "required": [
        "state",
        "selected_source_run_count",
        "exact_surface_distance_count",
        "partial_exact_match_count",
        "runs",
        "policy"
      ],
      "properties": {
        "state": {
          "enum": [
            "EXACT_SURFACE_DISTANCE_PRESENT",
            "PARTIAL_EXACT_MATCH_PRESENT",
            "NO_EXACT_TARGET_MATCH",
            "UNKNOWN"
          ]
        },
        "selected_source_run_count": {
          "type": "integer",
          "minimum": 0
        },
        "exact_surface_distance_count": {
          "type": "integer",
          "minimum": 0
        },
        "partial_exact_match_count": {
          "type": "integer",
          "minimum": 0
        },
        "runs": {
          "type": "array"
        },
        "policy": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "reviewInterpretation": {
      "type": "object",
      "required": [
        "state",
        "hidden_strength_status",
        "fragile_form_status",
        "contradiction_status",
        "repeatability_codes",
        "transferability",
        "reading_rule"
      ],
      "properties": {
        "state": {
          "enum": [
            "HIDDEN_STRENGTH",
            "FRAGILE_FORM",
            "MIXED",
            "SUPPORTIVE",
            "CAUTION",
            "MIXED_CONTEXT_ONLY",
            "INSUFFICIENT"
          ]
        },
        "hidden_strength_status": {
          "type": "string"
        },
        "fragile_form_status": {
          "type": "string"
        },
        "contradiction_status": {
          "type": "string"
        },
        "repeatability_codes": {
          "type": "array"
        },
        "transferability": {
          "$ref": "#/$defs/reviewTransferability"
        },
        "reading_rule": {
          "const": "CONTENT_FIRST_THEN_REPEATABILITY_THEN_TARGET_OVERLAP"
        }
      },
      "additionalProperties": false
    },
    "predictionInterpretation": {
      "type": "object",
      "required": [
        "interpretation_version",
        "data_trend",
        "race_structure",
        "racereview",
        "ability_anchor",
        "positive_case_components",
        "concern_case_components",
        "pairwise_reading_order",
        "policy"
      ],
      "properties": {
        "interpretation_version": {
          "const": "PredictionInterpretation-v0.1"
        },
        "data_trend": {
          "$ref": "#/$defs/trendInterpretation"
        },
        "race_structure": {
          "type": "object",
          "required": [
            "pace_pressure",
            "horse_historical_position",
            "running_style_trend_available",
            "reading_rule",
            "policy"
          ],
          "properties": {
            "pace_pressure": {
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "UNKNOWN"
              ]
            },
            "horse_historical_position": {
              "type": "object"
            },
            "running_style_trend_available": {
              "type": "boolean"
            },
            "reading_rule": {
              "const": "RACE_STRUCTURE_IS_RELATIVE_CONTEXT_NOT_AUTOMATIC_DIRECTION"
            },
            "policy": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "racereview": {
          "$ref": "#/$defs/reviewInterpretation"
        },
        "ability_anchor": {
          "type": "object",
          "required": [
            "role",
            "may_create_upgrade_by_itself",
            "may_create_downgrade_by_itself",
            "profile"
          ],
          "properties": {
            "role": {
              "enum": [
                "AVAILABLE_ANCHOR",
                "UNAVAILABLE"
              ]
            },
            "may_create_upgrade_by_itself": {
              "const": false
            },
            "may_create_downgrade_by_itself": {
              "const": false
            },
            "profile": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "positive_case_components": {
          "type": "array"
        },
        "concern_case_components": {
          "type": "array"
        },
        "pairwise_reading_order": {
          "const": [
            "DATA_TREND",
            "RACEREVIEW",
            "ABILITY_ANCHOR"
          ]
        },
        "policy": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "horse": {
      "type": "object",
      "required": [
        "horse_no",
        "horse_name",
        "horse_id",
        "current_facts",
        "evidence_lanes",
        "prediction_interpretation",
        "comparison_status"
      ],
      "properties": {
        "horse_no": {
          "type": "integer",
          "minimum": 1
        },
        "horse_name": {
          "type": "string"
        },
        "horse_id": {
          "type": "string"
        },
        "current_facts": {
          "type": "object"
        },
        "evidence_lanes": {
          "type": "object",
          "required": [
            "data_trend",
            "racereview",
            "ability_anchor"
          ],
          "properties": {
            "data_trend": {
              "$ref": "#/$defs/dataTrend"
            },
            "racereview": {
              "$ref": "#/$defs/raceReview"
            },
            "ability_anchor": {
              "$ref": "#/$defs/abilityAnchor"
            }
          },
          "additionalProperties": false
        },
        "prediction_interpretation": {
          "$ref": "#/$defs/predictionInterpretation"
        },
        "comparison_status": {
          "const": "NOT_YET_PAIRWISE_COMPARED"
        }
      },
      "additionalProperties": false
    }
  }
}
