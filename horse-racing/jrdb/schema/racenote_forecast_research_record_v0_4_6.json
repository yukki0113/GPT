{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "racenote_forecast_research_record_v0_4_6.json",
  "title": "RaceNote Forecast Research Record v0.4.6",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "research",
    "source",
    "prediction",
    "decision_trace",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "RaceNote-Forecast-Research-Record-0.4.6"
    },
    "identity": {
      "type": "object",
      "required": [
        "target_date",
        "venue",
        "race_no",
        "race_key"
      ],
      "additionalProperties": true
    },
    "research": {
      "type": "object",
      "required": [
        "evaluation_mode",
        "turn_id",
        "logic_version",
        "execution_contract",
        "independent_forecast",
        "baseline_marks_used_as_input"
      ],
      "properties": {
        "evaluation_mode": {
          "enum": [
            "BLINDED_HISTORICAL",
            "TRUE_FORWARD"
          ]
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "logic_version": {
          "const": "RaceNote-Human-Context-Reader-0.4.6-candidate"
        },
        "execution_contract": {
          "const": "RACENOTE_EXECUTION_V0.4.6"
        },
        "independent_forecast": {
          "const": true
        },
        "baseline_marks_used_as_input": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "racenote_identity",
        "reader_input_policy"
      ],
      "additionalProperties": true
    },
    "prediction": {
      "type": "object",
      "required": [
        "marks",
        "reader_facing_reason"
      ],
      "properties": {
        "marks": {
          "type": "object",
          "required": [
            "main",
            "second",
            "third",
            "others"
          ],
          "properties": {
            "main": {
              "$ref": "#/$defs/horse_ref"
            },
            "second": {
              "$ref": "#/$defs/horse_ref"
            },
            "third": {
              "$ref": "#/$defs/horse_ref"
            },
            "others": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/horse_ref"
              }
            }
          },
          "additionalProperties": true
        },
        "reader_facing_reason": {
          "type": "string",
          "minLength": 45
        }
      },
      "additionalProperties": true
    },
    "decision_trace": {
      "type": "object",
      "required": [
        "race_model",
        "mainline_cases",
        "single_shot_case",
        "support_boundary",
        "rrdb_evidence"
      ],
      "properties": {
        "race_model": {
          "type": "string",
          "minLength": 30
        },
        "mainline_cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "horse",
              "case"
            ],
            "properties": {
              "horse": {
                "$ref": "#/$defs/horse_ref"
              },
              "case": {
                "type": "string",
                "minLength": 8
              }
            },
            "additionalProperties": true
          }
        },
        "single_shot_case": {
          "type": "object",
          "required": [
            "horse",
            "selected_independently_from_mainline",
            "case"
          ],
          "properties": {
            "horse": {
              "$ref": "#/$defs/horse_ref"
            },
            "selected_independently_from_mainline": {
              "const": true
            },
            "case": {
              "type": "string",
              "minLength": 8
            }
          },
          "additionalProperties": true
        },
        "support_boundary": {
          "type": "object",
          "required": [
            "final_delta2",
            "alternative",
            "reason"
          ],
          "properties": {
            "final_delta2": {
              "$ref": "#/$defs/horse_ref"
            },
            "alternative": {
              "anyOf": [
                {
                  "$ref": "#/$defs/horse_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 8
            }
          },
          "additionalProperties": true
        },
        "rrdb_evidence": {
          "type": "object",
          "required": [
            "reviewed",
            "used_in_decision",
            "horse_refs"
          ],
          "properties": {
            "reviewed": {
              "const": true
            },
            "used_in_decision": {
              "type": "boolean"
            },
            "horse_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "horse_no",
                  "horse_name",
                  "decision_role"
                ],
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "required": [
        "pre_result_guard",
        "result_visible_at_freeze",
        "decision_core_sha256"
      ],
      "properties": {
        "pre_result_guard": {
          "const": "PASS"
        },
        "result_visible_at_freeze": {
          "const": false
        },
        "decision_core_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "horse_ref": {
      "type": "object",
      "required": [
        "horse_no",
        "horse_name"
      ],
      "properties": {
        "horse_no": {
          "type": "integer",
          "minimum": 1
        },
        "horse_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
